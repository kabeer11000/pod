# Namespace used by connections that do not pass ?ns=<namespace>
DEFAULT_NAMESPACE=default
# Port the WebSocket server listens on (ws://host:PORT/webchannel)
POD_PORT=3000
# LevelDB data directory
POD_STORAGE_PATH=./pod-storage
# Worker threads (0 / unset = number of CPU cores)
POD_THREADS=0
# fsync every commit (1/true). Slower, survives OS crashes as well as process crashes.
POD_SYNC_WRITES=0
# debug | info | warn | error
POD_LOG_LEVEL=info
# Commits kept in the commit log for delta resume (0 disables resume deltas)
POD_LOG_RETENTION=100000

# --- Security ---------------------------------------------------------------
# JSON security rules (see src/rules/rules.h). Unset = open mode.
POD_RULES_PATH=
# HS256 secret for client tokens (?t=<jwt>). Unset = tokens are refused.
POD_AUTH_SECRET=
# 1/true: refuse connections without a token
POD_REQUIRE_AUTH=0

# --- Cluster ----------------------------------------------------------------
# standalone (a database node) | router (the pods router, stores no data)
POD_ROLE=standalone
# Node: port routers connect to (unset = no router links)
POD_INTERNAL_PORT=
# Shared by routers and nodes, at least 16 characters
POD_CLUSTER_SECRET=
# Router: database nodes as id=host:internal_port, comma separated.
# Ids place namespaces on the ring: keep them stable.
POD_NODES=
# Router: ring points per node
POD_VIRTUAL_NODES=256
