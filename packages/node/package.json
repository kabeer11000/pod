{
  "name": "@pod-db/node",
  "version": "0.1.0",
  "description": "SDK and client library for Pod DB",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:esm": "bun build ./src/index.ts --outfile ./dist/index.js --target node --format esm",
    "build:cjs": "bun build ./src/index.ts --outfile ./dist/index.cjs --target node --format cjs",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir ./dist",
    "build": "bun run clean && bun run build:esm && bun run build:cjs && bun run build:types",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "idb-keyval": "^6.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
